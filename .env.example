# Velox Studio Configuration Environment Variables
# Copy this file to .env to customize local server or audit defaults.

# Local HTTP Studio Bind Address (default: 127.0.0.1)
VELOX_HOST=127.0.0.1

# Local HTTP Studio Port (default: 8080)
VELOX_PORT=8080

# Maximum memory-mapped arena size in MiB (default: 4096)
VELOX_MAX_MMAP_MIB=4096

# Default theme for exported HTML/SVG workbenches (dark | light)
VELOX_THEME=dark

# Epistemic Provenance Verifier Contact Email (used for Crossref/PubMed User-Agent header)
VELOX_PROVENANCE_EMAIL=integrity@velox-studio.dev
